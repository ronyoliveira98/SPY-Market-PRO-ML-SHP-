{
  "manifest_version": 3,
  "name": "SPY Market PRO (ML/SHP)",
  "version": "2.2.2",
  "description": "Ferramenta Inteligente de análise detalhada de concorrência e margem para Mercado Livre e Shopee. (By: Rony_DEV)",
  "author": "Rony_DEV 2026",

  "icons": {
    "16": "icons/extension/16.png",
    "32": "icons/extension/32.png",
    "48": "icons/extension/48.png",
    "128": "icons/extension/128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/extension/32.png",
        "icons/extension/*"
      ],
      "matches": [
        "https://*.mercadolivre.com.br/*",
        "https://*.mercadolibre.com/*",
        "https://*.shopee.com.br/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.mercadolivre.com.br/*",
        "https://*.shopee.com.br/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/extension/16.png",
      "32": "icons/extension/32.png",
      "48": "icons/extension/48.png",
      "128": "icons/extension/128.png"
    }
  }
}